# /etc/finplan/server.env (root:finplan, 0640). Read by finplan-server.service.
FINPLAN_BIND=127.0.0.1:8480
DATABASE_URL=sqlite:///var/lib/finplan/finplan.db
FINPLAN_HOSTED=true
FINPLAN_SECURE_COOKIES=true
FINPLAN_CORS_ORIGINS=https://finplan.rayknot.com
FINPLAN_ACCESS_MODE=beta
FINPLAN_REGISTRATION_OPEN=true
FINPLAN_LOG_FORMAT=json
FINPLAN_SIM_WORKERS=2
FINPLAN_MAX_ITERATIONS=10000

# Prometheus scrape endpoint; private listener, not proxied by the tunnel.
FINPLAN_METRICS_BIND=127.0.0.1:9480

# Password recovery and email verification stay unavailable until SMTP is set.
# All five values are required together; SMTP must use STARTTLS or implicit TLS.
#FINPLAN_SMTP_HOST=smtp.example.com
#FINPLAN_SMTP_PORT=587
#FINPLAN_SMTP_TLS=starttls
#FINPLAN_SMTP_USERNAME=
#FINPLAN_SMTP_PASSWORD=
#FINPLAN_MAIL_FROM=FinPlan <accounts@rayknot.com>
#FINPLAN_PUBLIC_URL=https://finplan.rayknot.com
