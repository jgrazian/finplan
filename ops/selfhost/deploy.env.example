# /etc/finplan/deploy.env. Read by finplan-deploy.
# The account that owns the Rust toolchain (~/.cargo) and Node (~/.local/bin).
FINPLAN_BUILD_USER=graz
# Deploy exactly this tag instead of the newest vX.Y.Z (e.g. to roll back).
# Remove the line to resume following new releases.
#FINPLAN_TAG=v0.9.0
