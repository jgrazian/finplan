            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(finplan_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(finplan_http_requests_total[$__rate_interval])), 1e-9) or vector(0)",
