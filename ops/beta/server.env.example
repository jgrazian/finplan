# Copy to server.env, chmod 600, and replace every example value.
# This file is loaded at runtime, never baked into either image.
# Keep signup closed until DNS, mail delivery, backups, and policy are verified.
FINPLAN_REGISTRATION_OPEN=false
FINPLAN_SMTP_HOST=smtp.example.com
FINPLAN_SMTP_PORT=587
FINPLAN_SMTP_TLS=starttls
FINPLAN_SMTP_USERNAME=replace-with-provider-username
FINPLAN_SMTP_PASSWORD=replace-with-provider-password
FINPLAN_MAIL_FROM=FinPlan <accounts@example.com>
FINPLAN_PUBLIC_URL=https://beta.example.com
